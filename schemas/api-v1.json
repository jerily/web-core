{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ttrek web API v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "routerMiddleware", "routes"],
  "oneOf": [
    {
      "title": "Installable package",
      "required": ["package", "summary", "mount", "inputs", "router"],
      "not": {"required": ["mounts"]}
    },
    {
      "title": "Router composition",
      "required": ["mounts"],
      "not": {"anyOf": [{"required": ["package"]}, {"required": ["mount"]}]}
    }
  ],
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": "ttrek-web-api/1"},
    "package": {"$ref": "#/$defs/package"},
    "summary": {"$ref": "#/$defs/text"},
    "mounts": {
      "type": "array",
      "uniqueItems": true,
      "description": "Ordered package installations. Each mount has a unique package name and prefix.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["package", "prefix"],
        "properties": {
          "package": {"$ref": "#/$defs/package"},
          "prefix": {"type": "string", "pattern": "^(/|(/[A-Za-z0-9_-]+)+)$"}
        }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "prefix", "docs"],
      "properties": {
        "command": {"$ref": "#/$defs/procName"},
        "prefix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["option", "default", "allowRoot"],
          "properties": {
            "option": {"type": "string", "pattern": "^-[a-zA-Z_][a-zA-Z0-9_-]*$"},
            "key": {"$ref": "#/$defs/text"},
            "default": {"type": "string", "pattern": "^(/|(/[A-Za-z0-9_-]+)*)$"},
            "allowRoot": {"type": "boolean"}
          }
        },
        "docs": {"$ref": "#/$defs/text"}
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/procName"},
      "additionalProperties": {"$ref": "#/$defs/commandDoc"}
    },
    "callbacks": {
      "type": "object",
      "description": "Host-supplied command prefixes keyed by mount setting.",
      "additionalProperties": {"$ref": "#/$defs/commandDoc"}
    },
    "inputs": {
      "type": "object",
      "description": "Boolean settings and policy fields available to route conditions at mount time.",
      "propertyNames": {"$ref": "#/$defs/inputName"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "default", "summary"],
        "properties": {
          "type": {"const": "boolean"},
          "default": {"type": "boolean"},
          "summary": {"$ref": "#/$defs/text"}
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "strict"],
      "properties": {"engine": {"const": "tpathexp"}, "strict": {"type": "boolean"}}
    },
    "routerMiddleware": {
      "type": "array",
      "description": "Router-wide middleware layers in registration order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [{"required": ["enter_proc"]}, {"required": ["leave_proc"]}],
        "properties": {
          "enter_proc": {"$ref": "#/$defs/prefix"},
          "leave_proc": {"$ref": "#/$defs/prefix"}
        }
      }
    },
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "package": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+(::[a-zA-Z0-9_-]+)*$"},
    "procName": {"type": "string", "pattern": "^(::[a-zA-Z_][a-zA-Z0-9_-]*)+$"},
    "inputName": {"type": "string", "pattern": "^(settings|policy)\\.[a-zA-Z_][a-zA-Z0-9_]*$"},
    "commandDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "returns", "summary"],
      "properties": {
        "arguments": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "returns": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "prefix": {
      "type": "array",
      "description": "Tcl command prefix. Each literal or binding contributes one word.",
      "minItems": 1,
      "prefixItems": [{"$ref": "#/$defs/procName"}],
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object", "additionalProperties": false,
            "properties": {"bind": {"const": "config"}}, "required": ["bind"]
          }
        ]
      }
    },
    "method": {"enum": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS", "PATCH", "TRACE", "CONNECT", "ANY"]},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "methods", "path", "handler"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "summary": {"$ref": "#/$defs/text"},
        "methods": {
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/method"},
          "if": {"contains": {"const": "ANY"}}, "then": {"maxItems": 1}
        },
        "path": {"type": "string", "pattern": "^($|/)"},
        "handler": {"$ref": "#/$defs/prefix"},
        "enter_proc": {"$ref": "#/$defs/prefix"},
        "leave_proc": {"$ref": "#/$defs/prefix"},
        "when": {
          "type": "object", "additionalProperties": false, "required": ["anyTrue"],
          "properties": {
            "anyTrue": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inputName"}}
          }
        },
        "access": {
          "type": "object", "additionalProperties": false,
          "oneOf": [{"required": ["signedIn"]}, {"required": ["permission"]}],
          "description": "Access required for each request. A permission requires a signed-in account with that grant.",
          "properties": {
            "signedIn": {"const": true},
            "permission": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
          }
        },
        "operations": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/method"},
          "additionalProperties": {"type": "string", "pattern": "^([A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.json(?:#/.*)?$"}
        }
      }
    }
  }
}
